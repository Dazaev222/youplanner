# Образец конфига restore-kaza.mjs. Скопируйте в _tools/restore-kaza.env
# (он в .gitignore) и заполните. Секреты не печатайте и не коммитьте.
#
# Достаточно ОДНОГО способа входа:
#   1) FB_REFRESH_TOKEN — refresh-токен из браузера с открытым YouPlanner:
#      F12 → Console → localStorage.getItem('youplanner.fb.refresh')
#   2) OWNER_EMAIL + OWNER_PASSWORD — почта и пароль владельца из Firebase
#      Authentication (то же, чем вы входите в приложении)

# URL базы. По умолчанию берётся из кода приложения (js/sync/core.js),
# указывать не обязательно — только если база сменилась.
#FIREBASE_URL=https://youplanner-XXXXX-default-rtdb.firebaseio.com/youplanner-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Веб-ключ Firebase. По умолчанию берётся из js/data/firebase-auth.js.
#FIREBASE_API_KEY=AIza...

# Способ входа 1: refresh-токен
#FB_REFRESH_TOKEN=AMf-...

# Способ входа 2: почта и пароль владельца
#OWNER_EMAIL=owner@example.com
#OWNER_PASSWORD=пароль
