{
  "contract": "0.5",
  "protocol": "access-v1",
  "schemaVersion": 1,
  "source": "MASTER_TZ_HARNESS_V2.md Раздел 7 (A7.2/A7.4/A7.5/A7.9). Одинаковая копия в обоих проектах: telegram-bridge/тесты/access-v1-fixture.json и youplanner-new/tests/access-v1-fixture.json.",
  "paths": {
    "policy": "bridge/access_policy/{ownerUid}/{deviceId}",
    "status": "bridge/access_status/{ownerUid}/{deviceId}"
  },
  "writers": {
    "policy": "owner (auth.token.owner==true, auth.uid==$ownerUid)",
    "status": "device (auth.token.device==true, auth.token.ownerUid==$ownerUid, auth.token.deviceId==$deviceId); владелец status не пишет"
  },
  "modes": [
    "safe",
    "medium",
    "unrestricted"
  ],
  "states": [
    "applying",
    "applied",
    "blocked",
    "error"
  ],
  "reasons": [
    "ok",
    "policy_missing",
    "policy_invalid",
    "policy_changed",
    "cloud_unreachable",
    "docker_unavailable",
    "image_missing",
    "stop_unconfirmed",
    "journal_unavailable",
    "unsupported_contract"
  ],
  "dockerStates": [
    "unknown",
    "ready",
    "unavailable",
    "image_missing"
  ],
  "routes": [
    "structured",
    "docker",
    "windows"
  ],
  "confirmationKind": "unrestricted_windows_v1",
  "versionRange": [
    1,
    9007199254740991
  ],
  "requestIdPattern": "^[A-Za-z0-9_-]{1,128}$",
  "unknownFieldsAllowed": false,
  "numbers": "конечные целые JSON-числа; bool/строка вместо числа запрещены; route вычисляет агент по mode, поле route в команде запрещено",
  "initialStatus": "До первого применения: observedVersion=0, observedRequestId=\"\", appliedVersion=0, appliedRequestId=\"\", effectiveMode=\"safe\" — локальный запрет запуска, НЕ автономное разрешение",
  "freshness": {
    "statusMaxAgeSec": 30,
    "heartbeatMaxAgeSec": 30,
    "statusUpdateIntervalSec": 10
  },
  "categories": {
    "read_file": "read",
    "write_file": "write",
    "edit": "write",
    "append_line": "write",
    "guarded_append_line": "write",
    "run_python": "execute",
    "model_task": "external_request",
    "prepare_python_workspace": "read"
  },
  "matrix": {
