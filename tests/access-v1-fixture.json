  "sessionRules": "Новая задача только при совпавшей сессии (presence.agentSessionId == access_status.agentSessionId) + свежих временах (≤30 с) + state=applied; ack после рестарта не подтверждает новый процесс; кэш unrestricted не даёт автономной работы после рестарта — сверка Firebase + confirmation + ack новой agentSessionId",
  "journal": {
    "schemaVersion": 2,
    "table": "harness_access_audit",
    "key": "(owner_uid, device_id, command_id, action_id, attempt_id)",
    "columns": [
      "policy_version",
      "policy_request_id",
      "mode",
      "route",
      "approval_id",
      "admission_ms",
      "outcome"
    ],
    "api": [
      "record_access_admission",
      "record_access_outcome"
    ],
    "rules": "admission до эффекта; отказ durable-записи запрещает start; admission не заменяет begin_effect/step_begin и не даёт права повторного запуска; миграция v1→2 транзакционная, команды/доставки не теряет; неизвестная будущая схема — отказ"
  },
  "deviationsOwner": [
    "read_file/write_file/edit исполняются НАПРЯМУЮ в Windows поверх границ sandbox.resolve_path (включая hardlink st_nlink>1); write_file/edit — новые инструменты категории write; в Safe/Medium каждый вызов через Approval, в Unrestricted — без Approval со всеми остальными ограничениями",
    "run_python в Safe/Medium — только Docker со snapshot-копией файлов (Задача B), без автоматического экспорта и без bind-mount; предупреждение «изменения не сохраняются в исходную папку»"
  ],
