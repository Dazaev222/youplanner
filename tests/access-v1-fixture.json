  "unknownTool": "отказ во всех режимах, включая unrestricted; ping/heartbeat прав на инструменты не дают",
  "runTaskParams": {
    "exact": {
      "actions": "1..16 действий текущей строгой схемы",
      "access": {
        "policyVersion": "целое",
        "policyRequestId": "string"
      }
    },
    "legacy": "run_task без access не исполняется: policy_context_missing; смена режима не легализует старую очередь"
  },
  "approvalBinding": {
    "preconditionsAccess": {
      "policyVersion": "целое",
      "policyRequestId": "string",
      "mode": "safe|medium|unrestricted",
      "route": "structured|docker|windows"
    },
    "digest": "approval_digest прежний {tool,params,cwd?,targets?} плюс access (именованный аргумент); consume проверяет digest И текущую политику, не только digest"
  },
  "grantContext": "голый approval_granted=true без контекста запрещён; grant несёт approvalId/digest/attempt/action/policyVersion/policyRequestId/route и полностью проверяется на продолжении",
